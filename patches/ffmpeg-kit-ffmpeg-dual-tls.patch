diff --git a/src/ffmpeg/libavformat/tls.c b/src/ffmpeg/libavformat/tls.c
--- a/src/ffmpeg/libavformat/tls.c
+++ b/src/ffmpeg/libavformat/tls.c
@@ -110,8 +110,26 @@ int ff_tls_open_underlying(TLSShared *c, URLContext *parent, const char *uri, AV
                     proxy_port, "/%s", dest);
     }
 
     freeenv_utf8(env_http_proxy);
     return ffurl_open_whitelist(&c->tcp, buf, AVIO_FLAG_READ_WRITE,
                                 &parent->interrupt_callback, options,
                                 parent->protocol_whitelist, parent->protocol_blacklist, parent);
 }
+
+const char *ff_tls_proto_name_for_url(void)
+{
+#if CONFIG_GNUTLS && CONFIG_OPENSSL
+    char *v = getenv_utf8("FFMPEG_HTTPS_TLS");
+    const char *ret = "tls_gnutls";
+    if (v) {
+        if (!av_strcasecmp(v, "openssl"))
+            ret = "tls_openssl";
+        else if (!av_strcasecmp(v, "gnutls"))
+            ret = "tls_gnutls";
+        freeenv_utf8(v);
+    }
+    return ret;
+#else
+    return "tls";
+#endif
+}

